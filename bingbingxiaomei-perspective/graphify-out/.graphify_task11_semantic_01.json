    {"id":"rationale_author_primary_evidence_boundary","label":"作者一级证据边界","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\SKILL.core.md","source_location":"§1","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"只有 author_post 和 author_reply 且具 author_primary 资格的内容可作为作者一级证据；第三方、摘要和图工具只可作候选。"},
    {"id":"rationale_article_and_stock_routes_are_mutually_exclusive","label":"文章解释与股票报告路由互斥","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\SKILL.core.md","source_location":"§4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"文章解释简报与股票报告按用户意图分流，文章出现公司名不会自动触发股票报告。"},
    {"id":"rationale_role_simulation_disclosure","label":"角色模拟披露与退出规则","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\SKILL.md","source_location":"§2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"首次激活角色须说明其为基于公开语料的视角模拟而非本人观点；用户要求退出角色时立即恢复正常表达。"},
    {"id":"rationale_article_claim_requires_primary_verification","label":"文章 Claim 的一级原文核验要求","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\references\\templates\\article-interpretation.md","source_location":"执行顺序 3-6","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"每个最小可验证 Claim 绑定一个历史关系结果；非 no_evidence 的关系必须回读 author_primary 原文并记录路径、segment、行号、短引和核验标记。"},
    {"id":"rationale_closed_relation_and_taxonomy_enumerations","label":"封闭的关系与 taxonomy 枚举","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\references\\templates\\article-interpretation.md","source_location":"执行顺序 6-7","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"历史关系只允许七种枚举；映射只允许 m01-m06 与 h01-h09。"},
    {"id":"rationale_ephemeral_article_input_boundary","label":"新文章的一次性输入边界","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\docs\\maintenance.md","source_location":"当前基线；新文章解读维护","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"新文章解读默认 ephemeral，不进入 canonical corpus、不改变 digest，也不触发 taxonomy 重建。"},
    {"id":"rationale_taxonomy_gate_and_derived_artifact_sync","label":"taxonomy Gate 与派生产物同步","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\docs\\maintenance.md","source_location":"更新流程 3-4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"模型和启发式的改变必须来自全量重读证据并经用户 Gate；随后按既定顺序同步模型、catalog、分类、Skill、测试与索引。"},
    {"id":"rationale_preserve_source_and_immutable_artifacts","label":"原文与不可变产物保留","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\docs\\maintenance.md","source_location":"更新流程 1；回退规则","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"canonical 原文不得删除、移动或批量覆盖；未通过 Gate 的新 taxonomy/current 不替换已验证版本。"},
    {"id":"rationale_graphify_must_be_regenerated","label":"Graphify 必须工具重生成","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\docs\\maintenance.md","source_location":"更新流程 4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"不得手改 graphify 生成图，派生产物变化后由工具重生成索引。"},
