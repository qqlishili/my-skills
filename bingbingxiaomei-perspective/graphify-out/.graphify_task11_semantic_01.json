    {"id":"rationale_article_cluster_is_evidence_entry_not_classifier","label":"主题簇是证据入口而非分类输出","file_type":"rationale","source_file":"D:\\Temp\\create_skills\\bingbingxiaomei-perspective\\references\\research\\07-article-clusters.md","source_location":"§0","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"主题簇和证据地图不能替代原文或当前分类输出，避免把旧关键词分类结果冒充当前 taxonomy 结果。"}
